<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:SC4CleanitolAvalonia.ViewModels"
			 mc:Ignorable="d"
			 x:Class="SC4CleanitolAvalonia.Views.Components.ScriptResultView"
			 x:DataType="vm:MainViewModel+ScriptResult"
			 d:DataContext="{x:Static vm:DesignData.ScriptResult}"
			 d:DesignWidth="800" d:DesignHeight="200">
	<Expander HorizontalAlignment="Stretch" VerticalAlignment="Top" IsVisible="{Binding HasFindings}">
		<Expander.Header>
			<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
				<SelectableTextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="{Binding ScriptName}" />
				<SelectableTextBlock
					Grid.Column="1"
					Margin="10,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"
					Text="{Binding FindingCountLabel}" />
				<Button
					Grid.Column="2"
					Padding="2"
					Command="{Binding OpenPackageInSc4pac}"
					ToolTip.Tip="Open in sc4pac">
					<StackPanel Orientation="Horizontal">
						<Label Classes="icon" Content="&#xe1da;" />
					</StackPanel>
				</Button>
				<Button
					Grid.Column="4"
					Padding="2"
					Command="{Binding CleanUpFiles}"
					ToolTip.Tip="Clean up files">
					<StackPanel Orientation="Horizontal">
						<Label Classes="icon" Content="&#xec54;" />
					</StackPanel>
				</Button>
			</Grid>
		</Expander.Header>
		<!--  Inner list of findings  -->
		<ItemsControl ItemsSource="{Binding FindingDisplayItems}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid
						Margin="20,1,0,1"
						ColumnDefinitions="Auto,Auto,*,Auto"
						ColumnSpacing="6">

						<!--  Level icon  -->
						<Label
							Grid.Column="0"
							Padding="0"
							VerticalAlignment="Center"
							Classes="icon"
							Content="{Binding Icon}"
							Foreground="{Binding IconColor}" />

						<!--  Item (filename / rule)  -->
						<SelectableTextBlock
							Grid.Column="1"
							VerticalAlignment="Center"
							FontFamily="Consolas, Courier New, monospace"
							Text="{Binding Item}" />

						<!--  Message  -->
						<SelectableTextBlock
							Grid.Column="2"
							VerticalAlignment="Center"
							Text="{Binding Message}"
							TextWrapping="Wrap" />

					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Expander>
</UserControl>
